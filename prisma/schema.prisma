// BirdJud — schema multi-tenant desde a primeira migracao.
//
// Regra: toda entidade de negocio nasce com escritorioId + indice.
// Nenhuma tabela global de negocio, nenhum dado herdado de outro sistema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Plataforma
// ---------------------------------------------------------------------------

model Escritorio {
  id     String  @id @default(cuid())
  slug   String  @unique // subdominio: <slug>.birdjud.com.br
  nome   String
  cnpj   String?
  status String  @default("TESTE") // TESTE | ATIVO | INADIMPLENTE | SUSPENSO | ENCERRADO
  faixa  String  @default("ATE_1") // ATE_1 | ATE_3 | ATE_10 | ATE_25 | ATE_50

  // A segunda senha: destrava o financeiro e a area de administracao. Do
  // escritorio, nao da pessoa. Nula ate ser definida — e enquanto for nula, a
  // area pede para definir, nunca deixa passar. Ver src/lib/administracao.ts.
  senhaAdminHash String?
  senhaAdminEm   DateTime?

  // Id deste escritorio como CLIENTE na conta Asaas da PLATAFORMA. Nao
  // confundir com Cliente.idNoAsaas, que vive na conta do escritorio: sao
  // contas diferentes, e misturar as duas cobraria a pessoa errada.
  idNaCobrancaDaPlataforma String?

  // marca e dados que, em sistemas de escritorio unico, ficam fixos no codigo
  logoUrl             String?
  corPrimaria         String?
  corSecundaria       String?
  telefoneAtendimento String?
  cidade              String?
  enderecos           Json?
  expediente          Json?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  // Encerramento: o prazo de retencao conta a partir daqui, e a purga da LGPD
  // so apaga depois dele.
  encerradoEm  DateTime?
  purgadoEm    DateTime?

  aceites           AceiteDeTermos[]
  usuarios          Usuario[]
  clientes          Cliente[]
  processos         Processo[]
  compromissos      Compromisso[]
  oabs              OabMonitorada[]
  publicacoes       Publicacao[]
  analises          AnaliseIA[]
  avisos            Aviso[]
  assinatura        Assinatura?
  faturas           Fatura[]
  lancamentos       Lancamento[]
  despesasFixas     DespesaFixa[]
  cobrancas         Cobranca[]
  arquivos          Arquivo[]
  notas             NotaFiscal[]
  fiscal            Fiscal?
  trabalhos         Trabalho[]
  modulos           ModuloContratado[]
  redefinicoes      RedefinicaoDeSenha[]
  integracoes       Integracao[]
  consumos          ConsumoMensal[]
  prazos            Prazo[]
  diasSemExpediente DiaSemExpediente[]
  itensDeChecklist  ItemDeChecklist[]
  representantes    Representante[]
}

model ModuloContratado {
  escritorioId String
  modulo       String // NUCLEO | PUBLICACOES_DJEN | WHATSAPP | EMAIL | NFSE | COBRANCAS | FINANCEIRO | ASSINATURA | IA | NUVEM
  ativo        Boolean  @default(true)
  franquia     Int? // ex.: mensagens/mes incluidas na faixa
  desde        DateTime @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@id([escritorioId, modulo])
  @@index([escritorioId])
}

model Integracao {
  id           String    @id @default(cuid())
  escritorioId String
  tipo         String // WHATSAPP_META | ASAAS | AUTENTIQUE | SMTP | MICROSOFT | GOOGLE | NFSE_CERT
  dados        Bytes // JSON criptografado (AES-256-GCM) — ver src/lib/segredo.ts
  status       String    @default("PENDENTE") // PENDENTE | OK | ERRO
  erro         String?
  verificadoEm DateTime?
  criadoEm     DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, tipo])
  @@index([escritorioId])
}

model ConsumoMensal {
  escritorioId String
  competencia  String // "2026-10"
  metrica      String // WHATSAPP_MSG | IA_TOKENS | NFSE_EMITIDA | OAB_MONITORADA | ARMAZENAMENTO_MB
  quantidade   Float  @default(0)

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@id([escritorioId, competencia, metrica])
  @@index([escritorioId])
}

// ---------------------------------------------------------------------------
// Nucleo — entidades de negocio (todas com escritorioId)
// ---------------------------------------------------------------------------

model Usuario {
  id           String    @id @default(cuid())
  escritorioId String
  nome         String
  email        String
  senhaHash    String
  papel        String    @default("USUARIO") // ADMIN | ADVOGADO | USUARIO
  oab          String?
  advogado     Boolean   @default(false) // conta na faixa de advogados
  ativo        Boolean   @default(true)
  doisFatores  String? // segredo TOTP, so quando ativado
  ultimoAcesso DateTime?

  // bloqueio por tentativas
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?

  // Sessao emitida antes disto nao vale mais. Trocar a senha empurra a marca
  // para agora, e as sessoes ja abertas caem na proxima requisicao.
  sessoesValidasApos DateTime?

  // Telefone em E.164 para o WhatsApp do escritorio. Guardado como digitado
  // e normalizado na hora do envio.
  telefone String?

  // O que esta pessoa quer receber por aviso, e por onde.
  recebeResumo    Boolean @default(true)
  recebeLembretes Boolean @default(true)
  recebeWhatsapp  Boolean @default(false)

  avisos   Aviso[]
  arquivos Arquivo[]
  criadoEm DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  prazos Prazo[]

  @@unique([escritorioId, email])
  @@index([escritorioId])
}

model Cliente {
  id           String   @id @default(cuid())
  escritorioId String
  nome         String
  documento    String? // CPF/CNPJ
  email        String?
  telefone     String?
  endereco     Json?
  // Id do mesmo cliente na conta Asaas DO ESCRITORIO. Guardado para nao criar
  // um cadastro novo a cada cobranca. Nao e dado nosso: some junto com o
  // cliente e nao vale entre escritorios.
  idNoAsaas    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorio   Escritorio    @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  processos    Processo[]
  cobrancas    Cobranca[]
  arquivos     Arquivo[]
  notas        NotaFiscal[]
  compromissos Compromisso[]

  prazos Prazo[]

  itensDeChecklist ItemDeChecklist[]

  representantes Representante[]

  @@index([escritorioId])
  @@index([escritorioId, documento])
}

model Processo {
  id           String    @id @default(cuid())
  escritorioId String
  clienteId    String?
  numero       String // numero unico do CNJ
  tribunal     String?
  vara         String?
  area         String?
  situacao     String    @default("ATIVO")
  distribuicao DateTime?
  criadoEm     DateTime  @default(now())

  escritorio   Escritorio    @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente      Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  compromissos Compromisso[]
  publicacoes  Publicacao[]
  cobrancas    Cobranca[]
  arquivos     Arquivo[]

  prazos Prazo[]

  itensDeChecklist ItemDeChecklist[]

  @@unique([escritorioId, numero])
  @@index([escritorioId])
}

model Compromisso {
  id           String    @id @default(cuid())
  escritorioId String
  processoId   String?
  // Tarefa exige cliente; agendamento nao. A coluna e nula porque a regra
  // vive na API — ver src/lib/compromissos.ts.
  clienteId    String?
  titulo       String
  tipo         String    @default("COMPROMISSO") // COMPROMISSO | AUDIENCIA | PRAZO | TAREFA
  inicio       DateTime
  fim          DateTime?
  local        String?
  observacoes  String?
  concluido    Boolean   @default(false)
  criadoEm     DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  processo   Processo?  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  cliente    Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([escritorioId])
  @@index([escritorioId, inicio])
  @@index([escritorioId, clienteId])
}

// ---------------------------------------------------------------------------
// Operador da plataforma — fora de qualquer escritorio.
// Todo acesso a um escritorio passa por AcessoSuporte (auditoria).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Venda: assinatura do proprio SaaS e faturas do escritorio
// ---------------------------------------------------------------------------

model Assinatura {
  escritorioId  String    @id
  // Preco fechado com este escritorio, em centavos. Fica gravado: mudanca de
  // tabela nao altera contrato ja assinado.
  valorCentavos Int
  diaVencimento Int       @default(10)
  fimDoTeste    DateTime
  canceladaEm   DateTime?
  criadaEm      DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
}

model Fatura {
  id            String    @id @default(cuid())
  escritorioId  String
  competencia   String // "2026-10"
  valorCentavos Int
  // Memoria de calculo: faixa, modulos e excedentes que geraram o valor.
  detalhe       Json?
  vencimento    DateTime
  status        String    @default("ABERTA") // ABERTA | PAGA | CANCELADA
  pagoEm        DateTime?
  idExterno     String?   @unique // id da cobranca no meio de pagamento
  linkPagamento String? // para onde mandar o escritorio pagar
  emitidaEm     DateTime? // quando a cobranca foi emitida no provedor
  // Retrato da baixa: sistema, referencia, quem pagou, quanto, como e quando.
  // A conta Asaas e compartilhada entre varios sistemas da Blackbird, e sem
  // isto nao havia como responder de quem foi um recebimento depois que o log
  // do provedor expira. Ver src/lib/referencia-cobranca.ts.
  baixa         Json?
  criadaEm      DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, competencia])
  @@index([escritorioId, status])
  @@index([status, vencimento])
}

model OperadorPlataforma {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  acessos AcessoSuporte[]
}

model AcessoSuporte {
  id           String    @id @default(cuid())
  operadorId   String
  escritorioId String
  motivo       String
  iniciadoEm   DateTime  @default(now())
  encerradoEm  DateTime?

  operador OperadorPlataforma @relation(fields: [operadorId], references: [id])

  @@index([escritorioId])
}

// ---------------------------------------------------------------------------
// Modulo FINANCEIRO — existe para o gate de modulo ter o que proteger
// ---------------------------------------------------------------------------

/// O que se repete todo mes e ninguem quer redigitar: aluguel, contabilidade,
/// internet. O valor e PREVISTO — conta de agua muda todo mes —, entao o
/// lancamento gerado entra como previsao e e corrigido quando a conta chega.
model DespesaFixa {
  id              String   @id @default(cuid())
  escritorioId    String
  descricao       String
  categoria       String
  fornecedor      String?
  valorCentavos   Int
  diaDoVencimento Int
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  escritorio  Escritorio   @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]

  @@index([escritorioId])
}

model Lancamento {
  id            String    @id @default(cuid())
  escritorioId  String
  descricao     String
  valorCentavos Int // em centavos: dinheiro nunca em ponto flutuante
  tipo          String // RECEITA | DESPESA
  // Categoria fechada (src/lib/financeiro.ts). Campo livre viraria "agua",
  // "Agua" e "AGUA" na mesma base, e nenhum grafico fecharia depois.
  categoria     String?
  fornecedor    String?
  competencia   String // "2026-09"
  vencimento    DateTime?
  pagoEm        DateTime?
  observacoes   String?
  // De qual cobranca do Asaas veio. Unico por escritorio: webhook chega em
  // duplicata, e a mesma cobranca nao pode virar dois lancamentos.
  cobrancaId    String?
  despesaFixaId String?
  arquivoId     String?
  criadoEm      DateTime  @default(now())

  escritorio  Escritorio   @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  despesaFixa DespesaFixa? @relation(fields: [despesaFixaId], references: [id], onDelete: SetNull)
  arquivo     Arquivo?     @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  @@index([escritorioId])
  @@index([escritorioId, competencia])
  @@index([escritorioId, categoria])
  @@index([escritorioId, vencimento])
}

// ---------------------------------------------------------------------------
// Cadastro fiscal e notas (modulo NFSE)
//
// O cadastro fiscal nao e credencial — e o que sai impresso na nota. Por isso
// mora aqui, e nao em Integracao (que guarda segredo cifrado). O certificado
// continua em Integracao.
// ---------------------------------------------------------------------------

model Fiscal {
  id                 String   @id @default(cuid())
  escritorioId       String   @unique
  razaoSocial        String
  cnpj               String
  inscricaoMunicipal String
  codigoMunicipio    String // IBGE, 7 digitos
  regime             String // SIMPLES | MEI | NORMAL
  codigoTributacao   String // item da lista de servicos, do contador
  aliquotaMilesimos  Int // 2% = 2000
  serie              String   @default("1")
  proximoNumero      Int      @default(1)
  ambiente           String   @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO
  atualizadoEm       DateTime @updatedAt

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
}

model NotaFiscal {
  id                 String    @id @default(cuid())
  escritorioId       String
  clienteId          String?
  cobrancaId         String?
  serie              String
  numero             Int
  descricao          String
  valorCentavos      Int
  // RASCUNHO -> EMITIDA | RECUSADA | INDETERMINADA; EMITIDA -> CANCELADA
  status             String    @default("RASCUNHO")
  chaveAcesso        String?
  numeroNaPrefeitura String?
  linkPdf            String?
  xmlEnviado         String? // o DPS assinado, como foi mandado
  xmlRetorno         String? // a NFS-e como voltou
  erro               String?
  emitidaEm          DateTime?
  canceladaEm        DateTime?
  criadoEm           DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente    Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@unique([escritorioId, serie, numero])
  @@index([escritorioId, status])
  @@index([escritorioId, criadoEm])
}

// ---------------------------------------------------------------------------
// Arquivos do escritorio (modulo NUVEM)
//
// A linha guarda o que se ve; o byte fica no disco, em caminho montado a
// partir de escritorioId + id — nunca a partir do nome que o usuario mandou.
// ---------------------------------------------------------------------------

model Arquivo {
  id           String   @id @default(cuid())
  escritorioId String
  clienteId    String?
  processoId   String?
  usuarioId    String? // quem subiu; vira null se a pessoa sai do escritorio
  nome         String
  descricao    String?
  tipo         String // tipo MIME declarado, ja conferido contra a extensao
  tamanhoBytes Int
  hash         String? // sha256 do conteudo, para conferir integridade
  criadoEm     DateTime @default(now())

  escritorio  Escritorio   @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente     Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  processo    Processo?    @relation(fields: [processoId], references: [id], onDelete: SetNull)
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  lancamentos Lancamento[]

  itensDeChecklist ItemDeChecklist[]

  @@index([escritorioId, criadoEm])
  @@index([escritorioId, processoId])
  @@index([escritorioId, clienteId])
}

// ---------------------------------------------------------------------------
// Cobrancas do escritorio para o cliente dele (modulo COBRANCAS)
//
// Nada a ver com Fatura, que e a plataforma cobrando do escritorio. Aqui o
// escritorio cobra o cliente dele, pela conta Asaas dele.
// ---------------------------------------------------------------------------

model Cobranca {
  id                String    @id @default(cuid())
  chaveOperacao     String?   @unique // mesma tentativa, inclusive apos perda da resposta
  escritorioId      String
  clienteId         String
  processoId        String?
  descricao         String
  valorCentavos     Int // em centavos: dinheiro nunca em ponto flutuante
  vencimento        DateTime
  forma             String // BOLETO | PIX | CARTAO | QUALQUER
  status            String    @default("ABERTA") // PENDENTE | ABERTA | PAGA | VENCIDA | CANCELADA | ESTORNADA
  // Id da cobranca na conta Asaas do escritorio. E a chave da sincronizacao.
  idNoAsaas         String
  linkPagamento     String?
  linkBoleto        String?
  pagoEm            DateTime?
  valorPagoCentavos Int?
  // Lancamento de receita gerado na baixa. Guardado para a baixa nao repetir.
  lancamentoId      String?
  sincronizadoEm    DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processo   Processo?  @relation(fields: [processoId], references: [id], onDelete: SetNull)

  @@unique([escritorioId, idNoAsaas])
  @@index([escritorioId, status])
  @@index([escritorioId, vencimento])
}

// ---------------------------------------------------------------------------
// Fila de trabalho — uma linha por trabalho, um trabalho por escritorio
// ---------------------------------------------------------------------------

model Trabalho {
  id            String    @id @default(cuid())
  escritorioId  String? // null = trabalho da propria plataforma
  tipo          String // APURAR_CONSUMO | ...
  dados         Json?
  estado        String    @default("PENDENTE") // PENDENTE | EXECUTANDO | CONCLUIDO | FALHOU
  tentativas    Int       @default(0)
  maxTentativas Int       @default(3)
  agendadoPara  DateTime  @default(now())
  iniciadoEm    DateTime?
  concluidoEm   DateTime?
  erro          String?
  criadoEm      DateTime  @default(now())

  escritorio Escritorio? @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([estado, agendadoPara])
  @@index([escritorioId, estado])
}

// ---------------------------------------------------------------------------
// Aceite dos documentos juridicos
// ---------------------------------------------------------------------------

model AceiteDeTermos {
  id           String   @id @default(cuid())
  escritorioId String
  // Quem aceitou. Fica solto de proposito: o aceite sobrevive a exclusao do
  // usuario, porque e prova de contrato.
  usuarioEmail String
  usuarioNome  String
  documento    String // TERMOS | CONTRATO | LGPD
  versao       String // "2026-09-18"
  ip           String?
  navegador    String?
  aceitoEm     DateTime @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([escritorioId, documento])
}

// ---------------------------------------------------------------------------
// Limite de taxa — tabela da plataforma, compartilhada entre instancias
// ---------------------------------------------------------------------------

model LimiteDeTaxa {
  chave      String   @id
  tentativas Int      @default(1)
  ate        DateTime
}

// ---------------------------------------------------------------------------
// Modulo PUBLICACOES_DJEN
// ---------------------------------------------------------------------------

model OabMonitorada {
  id            String    @id @default(cuid())
  escritorioId  String
  numero        String // so digitos
  uf            String // sigla, 2 letras
  nomeAdvogado  String?
  ativo         Boolean   @default(true)
  ultimaCaptura DateTime?
  criadoEm      DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, numero, uf])
  @@index([escritorioId, ativo])
}

model Publicacao {
  id           String  @id @default(cuid())
  escritorioId String
  // Id da comunicacao no DJEN. E o que impede a mesma publicacao de entrar
  // duas vezes quando duas OABs do escritorio aparecem no mesmo ato.
  idExterno    String
  processoId   String? // vinculado quando o numero ja existe no escritorio

  numeroProcesso  String?
  tribunal        String?
  orgao           String?
  tipoComunicacao String?
  texto           String
  link            String?
  oab             String? // qual OAB monitorada trouxe

  dataDisponibilizacao DateTime
  // Classificacao automatica a partir do texto, sempre conferivel pelo humano.
  urgente              Boolean  @default(false)
  prazoDias            Int?

  lida      Boolean  @default(false)
  arquivada Boolean  @default(false)
  criadoEm  DateTime @default(now())

  escritorio Escritorio  @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  processo   Processo?   @relation(fields: [processoId], references: [id], onDelete: SetNull)
  analises   AnaliseIA[]

  @@unique([escritorioId, idExterno])
  @@index([escritorioId, lida, arquivada])
  @@index([escritorioId, dataDisponibilizacao])
}

// ---------------------------------------------------------------------------
// Avisos (modulo EMAIL hoje; WhatsApp usa a mesma fila depois)
// ---------------------------------------------------------------------------

model Aviso {
  id           String  @id @default(cuid())
  escritorioId String
  usuarioId    String?

  canal   String // EMAIL | WHATSAPP
  tipo    String // RESUMO_PUBLICACOES | LEMBRETE_COMPROMISSO
  // Chave de idempotencia: e ela que impede o mesmo aviso de sair duas vezes
  // quando a rotina roda de novo, ou quando duas instancias rodam juntas.
  chave   String
  destino String

  assunto String
  corpo   String

  // So no canal WHATSAPP: o modelo aprovado na Meta e os parametros dele, na
  // ordem. Ficam gravados porque e o que foi realmente mandado — o corpo
  // acima e a versao legivel, para o escritorio ler depois.
  modelo     String?
  parametros Json?

  estado     String    @default("PENDENTE") // PENDENTE | ENVIADO | FALHOU
  tentativas Int       @default(0)
  erro       String?
  enviadoEm  DateTime?
  criadoEm   DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, chave])
  @@index([escritorioId, estado])
}

// ---------------------------------------------------------------------------
// Modulo IA
// ---------------------------------------------------------------------------

model AnaliseIA {
  id           String  @id @default(cuid())
  escritorioId String
  usuarioId    String?
  publicacaoId String?

  tipo   String // ANALISE_PUBLICACAO | MINUTA_MANIFESTACAO
  // O modelo que REALMENTE respondeu: com fallback de recusa, pode nao ser o
  // que foi pedido. Sem isso, a auditoria de uma peca fica sem origem.
  modelo String

  resultado     String
  tokensEntrada Int
  tokensSaida   Int
  criadoEm      DateTime @default(now())

  escritorio Escritorio  @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  publicacao Publicacao? @relation(fields: [publicacaoId], references: [id], onDelete: SetNull)

  @@index([escritorioId, criadoEm])
  @@index([publicacaoId])
}

// Pedido de redefinicao de senha.
//
// Guarda o HASH do token, nunca o token: quem ler esta tabela nao entra na
// conta de ninguem. O token em si so existe no link que foi para o e-mail.
model RedefinicaoDeSenha {
  id           String    @id @default(cuid())
  escritorioId String
  usuarioId    String
  // REDEFINICAO (esqueci a senha) | CONVITE (usuario novo definindo a
  // primeira senha). Muda o texto do e-mail e a validade do link.
  tipo         String    @default("REDEFINICAO")
  tokenHash    String    @unique
  expiraEm     DateTime
  usadoEm      DateTime?
  // IP de quem pediu, para investigar pedido em massa.
  pedidoDe     String?
  criadoEm     DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([escritorioId])
  @@index([escritorioId, usuarioId])
  @@index([expiraEm])
}

// ---------------------------------------------------------------------------
// Prazos processuais
// ---------------------------------------------------------------------------

/// Prazo com data fatal. A conta mora em src/lib/prazos.ts e nunca vem pronta
/// da leitura de um documento: prazo errado perde o direito.
model Prazo {
  id             String    @id @default(cuid())
  escritorioId   String
  processoId     String?
  clienteId      String?
  titulo         String
  /// Data da intimacao ou ciencia. O dia do comeco e excluido (CPC 224).
  termoInicial   DateTime  @db.Date
  dias           Int
  /// UTEIS (CPC 219) | CORRIDOS (CPP 798, direito material)
  contagem       String    @default("UTEIS")
  /// Resultado da conta, guardado para nao depender de recalcular depois: o
  /// calendario do escritorio muda, e um prazo ja comunicado ao cliente nao
  /// pode mudar de data sozinho.
  inicioContagem DateTime  @db.Date
  vencimento     DateTime  @db.Date
  /// Como a data foi obtida, em linguagem de gente. E o que permite conferir
  /// sem abrir o codigo.
  explicacao     String
  responsavelId  String?
  cumpridoEm     DateTime?
  observacao     String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  escritorio  Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  processo    Processo?  @relation(fields: [processoId], references: [id], onDelete: SetNull)
  cliente     Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  responsavel Usuario?   @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([escritorioId, vencimento])
  @@index([escritorioId, cumpridoEm])
  @@index([escritorioId, processoId])
}

/// Dia sem expediente do proprio escritorio: feriado municipal, suspensao de
/// tribunal, ponto facultativo da comarca. Nao cabe em lista nacional porque
/// cada escritorio trabalha em comarcas diferentes.
model DiaSemExpediente {
  id           String   @id @default(cuid())
  escritorioId String
  dia          DateTime @db.Date
  motivo       String
  criadoEm     DateTime @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, dia])
  @@index([escritorioId, dia])
}

/// Item da lista de documentos de um cliente. Um por documento pedido, para
/// que alguem possa marcar o que ja chegou e ligar ao arquivo que chegou.
model ItemDeChecklist {
  id           String    @id @default(cuid())
  escritorioId String
  clienteId    String
  processoId   String?
  /// PESSOAIS | DO_CASO | AJUDAM | GRATUIDADE | ACESSOS
  grupo        String
  documento    String
  paraQue      String
  essencial    Boolean   @default(false)
  ordem        Int       @default(0)
  /// O que o escritorio escreveu como motivo da lista (tipo de acao).
  tipoAcao     String?
  entregueEm   DateTime?
  /// O arquivo que cumpriu este item, quando ha um.
  arquivoId    String?
  criadoEm     DateTime  @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processo   Processo?  @relation(fields: [processoId], references: [id], onDelete: SetNull)
  arquivo    Arquivo?   @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  @@index([escritorioId, clienteId])
  @@index([escritorioId, entregueEm])
}

/// Quem assina pela pessoa juridica. Mais de um quando os socios assinam em
/// conjunto. Diferente do sistema que inspirou isto, TODOS moram aqui — dois
/// lugares para o mesmo dado e onde nasce a peca faltando um socio.
model Representante {
  id                     String   @id @default(cuid())
  escritorioId           String
  clienteId              String
  ordem                  Int      @default(0)
  nome                   String
  cpf                    String
  rg                     String?
  nacionalidade          String?
  estadoCivil            String?
  profissao              String?
  /// Por onde a assinatura eletronica chega.
  email                  String?
  telefone               String?
  mesmoEnderecoDaEmpresa Boolean  @default(true)
  endereco               Json?
  criadoEm               DateTime @default(now())

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([escritorioId, clienteId])
}
