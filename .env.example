# ---------------------------------------------------------------------------
# BirdJud — variaveis da PLATAFORMA apenas.
#
# Regra de independencia: credenciais de ESCRITORIO (WhatsApp, Asaas, AASP,
# Autentique, SMTP, OneDrive, Google, e-CNPJ) NAO ficam aqui. Elas sao
# cadastradas por cada escritorio e guardadas criptografadas na tabela
# Integracao. Nenhum valor vindo de outro sistema deve ser copiado para ca.
# ---------------------------------------------------------------------------

# Banco proprio e vazio deste produto. Nunca apontar para o banco de outro sistema.
# O usuario da aplicacao NAO pode ser dono das tabelas nem superusuario (RLS).
DATABASE_URL="postgresql://birdjud_app:senha@localhost:5432/birdjud?schema=public"

# Usuario dono/migrador, usado so pelas migracoes e pelo script de RLS.
DATABASE_URL_MIGRACAO="postgresql://birdjud_owner:senha@localhost:5432/birdjud?schema=public"

# Plano de controle (papel com BYPASSRLS): cadastro de escritorio, painel do
# operador e rotinas que percorrem escritorios. Nunca usar em rota de escritorio.
DATABASE_URL_PLATAFORMA="postgresql://birdjud_plataforma:senha@localhost:5432/birdjud?schema=public"

# Sessao
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Chave de criptografia das credenciais de escritorio (32 bytes em base64).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEGREDO_CHAVE=""

# Dominio da plataforma; cada escritorio atende em <slug>.<dominio>
DOMINIO_PLATAFORMA="birdjud.com.br"

# Chave de IA da PLATAFORMA (o escritorio nao traz a dele). O consumo e medido
# por escritorio em ConsumoMensal, na metrica IA_MIL_TOKENS.
ANTHROPIC_API_KEY=""

# So para teste: aponta a API da IA para outro endereco. Vazio em producao.
ANTHROPIC_BASE_URL=""

# Base da API do DJEN. So mude em teste.
DJEN_BASE_URL=""

# Rele do DJEN na Vercel (regiao gru1, Sao Paulo). A API do CNJ bloqueia acesso
# de fora do Brasil; com estas duas preenchidas, a consulta sai pelo rele e a
# aplicacao pode rodar em qualquer regiao. Vazias, vai direto e so funciona do
# Brasil. O token e o mesmo RELE_TOKEN configurado na Vercel. Ver docs/RELE-DJEN.md.
DJEN_RELE_URL=""
DJEN_RELE_TOKEN=""

# Base da API do Asaas. So mude em teste (sandbox ou servidor falso). A chave
# de API NAO fica aqui: e de cada escritorio, cadastrada em Integracoes e
# guardada criptografada.
ASAAS_BASE_URL=""

# Base da API da Meta (WhatsApp). So mude em teste. O ID do numero e o token
# NAO ficam aqui: sao de cada escritorio, cadastrados em Integracoes.
META_BASE_URL=""

# Base do ambiente nacional da NFS-e. So mude em teste. O certificado e o
# cadastro fiscal NAO ficam aqui: sao de cada escritorio.
NFSE_BASE_URL=""

# Onde ficam os arquivos do modulo NUVEM. No Railway, aponte para o ponto de
# montagem de um VOLUME — disco de container e efemero, e sem volume os
# arquivos somem no proximo deploy. Vazio usa ./dados/arquivos (so local).
RAIZ_ARQUIVOS=""

# Token do webhook de pagamento da PLATAFORMA (baixa automatica das faturas dos
# escritorios). Cadastre o mesmo valor no Asaas, em Integracoes > Webhooks.
# Sem ele, a rota /api/webhooks/asaas responde 503 e a baixa fica manual.
ASAAS_WEBHOOK_TOKEN=""

# Endereco comercial mostrado na pagina de planos para escritorio acima da
# maior faixa publicada. Sem ele, o botao leva ao teste.
CONTATO_COMERCIAL=

# ---------------------------------------------------------------------------
# Remetente da PLATAFORMA
# ---------------------------------------------------------------------------
# Diferente do SMTP que cada escritorio conecta em Integracoes: este e o
# remetente das poucas mensagens que a plataforma manda por conta propria —
# hoje, a recuperacao de senha. Sem ele, a tela diz que a recuperacao esta
# indisponivel, em vez de fingir que o e-mail saiu.
#
# Serve qualquer SMTP: servico de envio (Resend, Brevo, SendGrid) ou conta
# comum com senha de aplicativo.
PLATAFORMA_SMTP_HOST=
PLATAFORMA_SMTP_PORTA=587
PLATAFORMA_SMTP_USUARIO=
PLATAFORMA_SMTP_SENHA=
# Como o remetente aparece na caixa de quem recebe.
PLATAFORMA_REMETENTE="BirdJud <blackbirdnotifica@gmail.com>"
# Opcional: para onde vai a resposta, se for diferente do remetente.
PLATAFORMA_RESPONDER_PARA=

# ---------------------------------------------------------------------------
# WhatsApp de SAIDA: o numero UNICO da plataforma.
#
# Nao e por escritorio. Um aplicativo na Meta, criado para isto, e um numero
# so para toda a plataforma — o escritorio nao abre conta na Meta. A mensagem
# se apresenta com o nome da banca e traz o telefone dela, porque este numero
# NOTIFICA e nao atende.
#
# WHATSAPP_NUMERO_ID: o "Phone number ID" do numero no WhatsApp Manager.
# WHATSAPP_TOKEN: token permanente do usuario de sistema do aplicativo.
# ---------------------------------------------------------------------------
WHATSAPP_NUMERO_ID=
WHATSAPP_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp de ENTRADA: a resposta do cliente ao lembrete de audiencia.
#
# As duas andam juntas. Sem elas o webhook responde 503, a Meta nao consegue
# ligar o endereco, e quem responder "1" ao lembrete nunca vai aparecer como
# confirmado na agenda — sem erro nenhum na tela.
#
# WHATSAPP_VERIFICACAO: qualquer segredo. A Meta manda de volta uma vez, ao
#   ligar o webhook, e so aceita o endereco se a resposta bater.
# WHATSAPP_APP_SECRET: o "App Secret" do aplicativo da Meta. E com ele que se
#   confere a assinatura de cada chamada — sem isso, qualquer um confirmaria a
#   audiencia de qualquer cliente.
#
# Endereco a cadastrar na Meta: https://<dominio>/api/webhooks/whatsapp
# ---------------------------------------------------------------------------
WHATSAPP_VERIFICACAO=
WHATSAPP_APP_SECRET=

# --- Guarda do site (volta automatica de deploy) --------------------------
# Vive no servico do TRABALHADOR, nao na aplicacao: quando a aplicacao cai,
# e o trabalhador que precisa continuar de pe para mandar voltar.
#
# O token e de PROJETO (Railway > Project Settings > Tokens), nao de conta:
# ele so alcanca este projeto, e so e usado para ler deploys e voltar um
# deles. As quatro juntas, ou nenhuma — pela metade a guarda nao liga.
RAILWAY_TOKEN_GUARDA=
RAILWAY_PROJETO_ID=
RAILWAY_AMBIENTE_ID=
RAILWAY_SERVICO_APP_ID=
# Opcional: onde bater. O padrao e https://$DOMINIO_PLATAFORMA/api/saude
GUARDA_ENDERECO=
