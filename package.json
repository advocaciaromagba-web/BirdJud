{
  "name": "birdjud",
  "version": "0.1.0",
  "private": true,
  "description": "BirdJud — sistema juridico white label multi-tenant para escritorios de advocacia",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "rls:aplicar": "node scripts/aplicar-rls.mjs",
    "teste": "vitest run",
    "teste:isolamento": "vitest run testes/isolamento.test.ts",
    "migrar": "node scripts/migrar.mjs",
    "start:producao": "npm run migrar && npm run rls:aplicar && next start",
    "trabalhador": "tsx scripts/trabalhador.ts",
    "espalhar": "tsx scripts/espalhar-trabalho.ts",
    "criar-operador": "tsx scripts/criar-operador.ts",
    "backup": "tsx scripts/backup-escritorio.ts",
    "restaurar": "tsx scripts/restaurar-escritorio.ts",
    "conferir-djen": "tsx scripts/conferir-djen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "node-forge": "^1.4.0",
    "nodemailer": "^7.0.13",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/smtp-server": "^3.5.13",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
